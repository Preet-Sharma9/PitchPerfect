# Which provider to use: "groq" (free cloud) or "ollama" (local)
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com (use a PERSONAL email)
GROQ_API_KEY=

# Local fallback (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Models (Groq free-tier model ids). For ollama, set these to a pulled model e.g. "llama3.1"
# Check https://console.groq.com/playground for currently available models
DEFAULT_MODEL=groq/compound-mini
WRITER_MODEL=groq/compound-mini

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
